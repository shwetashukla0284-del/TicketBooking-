// Prisma Schema for Ticket Booking System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String          @id @default(uuid())
  name         String
  email        String          @unique
  passwordHash String
  role         String          @default("CUSTOMER") // CUSTOMER, ORGANISER, ADMIN
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  events       Event[]         @relation("OrganiserEvents")
  holds        Hold[]
  bookings     Booking[]
  waitlists    WaitlistEntry[]
}

model Venue {
  id        String      @id @default(uuid())
  name      String
  address   String
  capacity  Int
  status    String      @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  seats     VenueSeat[]
  events    Event[]
}

model SeatCategory {
  id          String      @id @default(uuid())
  name        String      @unique // Premium, Standard, VIP Box
  description String?
  
  venueSeats  VenueSeat[]
  showSeats   ShowSeat[]
  waitlists   WaitlistEntry[]
}

model VenueSeat {
  id         String       @id @default(uuid())
  venueId    String
  row        String
  seatNumber Int
  categoryId String
  positionX  Int          @default(0)
  positionY  Int          @default(0)

  venue      Venue        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  category   SeatCategory @relation(fields: [categoryId], references: [id])
  showSeats  ShowSeat[]

  @@unique([venueId, row, seatNumber])
}

model Event {
  id          String      @id @default(uuid())
  organiserId String
  venueId     String
  title       String
  type        String      // MOVIE, CONCERT
  description String
  imageUrl    String?
  status      String      @default("DRAFT") // DRAFT, PUBLISHED, SOLD_OUT, CANCELLED, COMPLETED
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  organiser   User        @relation("OrganiserEvents", fields: [organiserId], references: [id])
  venue       Venue       @relation(fields: [venueId], references: [id])
  shows       Show[]
}

model Show {
  id        String          @id @default(uuid())
  eventId   String
  startTime DateTime
  endTime   DateTime
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  showSeats ShowSeat[]
  holds     Hold[]
  bookings  Booking[]
  waitlists WaitlistEntry[]
}

model ShowSeat {
  id          String        @id @default(uuid())
  showId      String
  venueSeatId String
  categoryId  String
  price       Float
  status      String        @default("AVAILABLE") // AVAILABLE, HELD, BOOKED
  version     Int           @default(1) // For optimistic concurrency checks

  show        Show          @relation(fields: [showId], references: [id], onDelete: Cascade)
  venueSeat   VenueSeat     @relation(fields: [venueSeatId], references: [id])
  category    SeatCategory  @relation(fields: [categoryId], references: [id])
  
  holdItems   HoldItem[]
  bookingItem BookingItem?
  waitlistOffers WaitlistOffer[]

  @@unique([showId, venueSeatId])
  @@index([showId, status])
}

model Hold {
  id        String     @id @default(uuid())
  userId    String
  showId    String
  expiresAt DateTime
  status    String     @default("ACTIVE") // ACTIVE, COMPLETED, EXPIRED
  createdAt DateTime   @default(now())

  user      User       @relation(fields: [userId], references: [id])
  show      Show       @relation(fields: [showId], references: [id])
  items     HoldItem[]

  @@index([expiresAt, status])
}

model HoldItem {
  id         String   @id @default(uuid())
  holdId     String
  showSeatId String

  hold       Hold     @relation(fields: [holdId], references: [id], onDelete: Cascade)
  showSeat   ShowSeat @relation(fields: [showSeatId], references: [id])

  @@unique([holdId, showSeatId])
}

model Booking {
  id          String        @id @default(uuid())
  reference   String        @unique // e.g. TBS-2026-AB12CD
  userId      String
  showId      String
  totalAmount Float
  status      String        @default("CONFIRMED") // CONFIRMED, CANCELLED, EXPIRED
  createdAt   DateTime      @default(now())
  cancelledAt DateTime?

  user        User          @relation(fields: [userId], references: [id])
  show        Show          @relation(fields: [showId], references: [id])
  items       BookingItem[]

  @@index([userId])
}

model BookingItem {
  id         String   @id @default(uuid())
  bookingId  String
  showSeatId String   @unique
  price      Float

  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  showSeat   ShowSeat @relation(fields: [showSeatId], references: [id])
}

model WaitlistEntry {
  id            String         @id @default(uuid())
  showId        String
  categoryId    String
  userId        String
  queuePosition Int
  status        String         @default("WAITING") // WAITING, OFFERED, ACCEPTED, EXPIRED, CANCELLED
  createdAt     DateTime       @default(now())

  show          Show           @relation(fields: [showId], references: [id], onDelete: Cascade)
  category      SeatCategory   @relation(fields: [categoryId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  offers        WaitlistOffer[]

  @@index([showId, categoryId, status, queuePosition])
}

model WaitlistOffer {
  id              String              @id @default(uuid())
  waitlistEntryId String
  showSeatId      String
  token           String              @unique
  expiresAt       DateTime
  status          String              @default("ACTIVE") // ACTIVE, ACCEPTED, EXPIRED
  createdAt       DateTime            @default(now())

  waitlistEntry   WaitlistEntry       @relation(fields: [waitlistEntryId], references: [id], onDelete: Cascade)
  showSeat        ShowSeat            @relation(fields: [showSeatId], references: [id])

  @@index([expiresAt, status])
}
