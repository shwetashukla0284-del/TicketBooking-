# Database Connection (SQLite default for zero-config local dev, or PostgreSQL)
DATABASE_URL="file:./dev.db"

# JWT Secret for Auth Sessions
JWT_SECRET="ticket-booking-secret-key-2026-change-in-prod"

# Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Configurable Seat Hold & Waitlist Expiration TTLs (Minutes)
SEAT_HOLD_TTL_MINUTES=10
WAITLIST_OFFER_TTL_MINUTES=5

# Email Settings (Nodemailer / Ethereal fallback)
EMAIL_HOST="smtp.ethereal.email"
EMAIL_PORT=587
EMAIL_USER=""
EMAIL_PASSWORD=""
EMAIL_FROM="noreply@ticketbooking.com"
